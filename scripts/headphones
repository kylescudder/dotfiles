#!/usr/bin/env bash
set -euo pipefail

CARD_NAME="alsa_card.pci-0000_00_1f.3"
PROFILE="output:analog-stereo+input:analog-stereo"
SINK_NAME="alsa_output.pci-0000_00_1f.3.analog-stereo"

echo "Routing to headphones..."
pactl set-card-profile "${CARD_NAME}" "${PROFILE}"
change_audio "${SINK_NAME}"
playerctl play 2>/dev/null || true
