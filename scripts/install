#!/usr/bin/env bash

set -euo pipefail

version="${BIDE_VERSION:-0.1.0}"
install_dir="${BIDE_INSTALL_DIR:-$HOME/.local/bin}"
systemd_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"

case "$(uname -m)" in
    x86_64) target="x86_64-unknown-linux-gnu" ;;
    aarch64|arm64) target="aarch64-unknown-linux-gnu" ;;
    *) printf 'Bide installer: unsupported architecture: %s\n' "$(uname -m)" >&2; exit 2 ;;
esac

for command in curl tar systemctl; do
    command -v "$command" >/dev/null 2>&1 || {
        printf 'Bide installer: required command is missing: %s\n' "$command" >&2
        exit 127
    }
done

temp_dir="$(mktemp -d)"
trap 'rm -rf -- "$temp_dir"' EXIT
archive="$temp_dir/bide.tar.gz"
url="https://github.com/kylescudder/bide/releases/download/v${version}/bide-${target}.tar.gz"

printf 'Installing Bide v%s for %s...\n' "$version" "$target"
curl --fail --location --silent --show-error "$url" --output "$archive" || {
    printf 'Bide installer: could not download %s\n' "$url" >&2
    exit 1
}
tar -xzf "$archive" -C "$temp_dir"
[[ -x "$temp_dir/bide" ]] || { printf 'Bide installer: release does not contain an executable bide binary\n' >&2; exit 1; }
mkdir -p "$install_dir" "$systemd_dir"
install -m 0755 "$temp_dir/bide" "$install_dir/bide"

sed "s|%h/.local/bin/bide|$install_dir/bide|" \
    "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/systemd/bide.service" \
    >"$systemd_dir/bide.service"
install -m 0644 "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/systemd/bide.timer" "$systemd_dir/bide.timer"

systemctl --user daemon-reload
systemctl --user enable --now bide.timer
command -v bide >/dev/null 2>&1 || [[ -x "$install_dir/bide" ]] || {
    printf 'Bide installer: installation completed but bide is not executable\n' >&2
    exit 1
}
"$install_dir/bide" --version
