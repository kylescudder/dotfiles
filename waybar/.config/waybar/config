{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 10,
    "spacing": 2,
    "fixed-center": true,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["group/system", "custom/tomat", "custom/notification", "pulseaudio", "network", "group/group_power"],

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "9": ""
        },
        "sort-by": "number",
        "persistent-workspaces": {
            "*": 10
        },
        "tooltip": false
    },

    "custom/tomat": {
        "exec": "tomat watch",
        "exec-if": "command -v tomat",
        "exec-on-event": false,
        "restart-interval": 2,
        "return-type": "json",
        "format": "{}",
        "on-click": "$HOME/.config/rofi/launcher.sh --show tomat",
        "on-click-middle": "tomat toggle",
        "on-click-right": "tomat skip"
    },

    "group/system": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "children-class": "system-detail",
            "transition-left-to-right": false
        },
        "modules": ["custom/system", "cpu", "memory", "temperature"]
    },

    "custom/system": {
        "format": "󱕍",
        "tooltip": true,
        "tooltip-format": "System usage"
    },

    "cpu": {
        "format": "󰻠 {usage}%",
        "tooltip": false
    },

    "memory": {
        "format": "󰍛 {percentage}%",
        "tooltip": false
    },

    "temperature": {
        "critical-threshold": 80,
        "format": "{icon} {temperatureC}°",
        "format-icons": ["", "", ""],
        "tooltip": false
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-bluetooth": "{icon} 󰂯",
        "format-muted": "󰖁",
        "format-bluetooth-muted": "󰖁 󰂯",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰋎",
            "headset": "󰋎",
            "phone": "󰏲",
            "portable": "󰏲",
            "car": "󰄋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "tooltip-format": "{desc}\nVolume: {volume}%",
        "on-click": "pavucontrol"
    },

    "network": {
        "format-wifi": "󰖩",
        "format-ethernet": "󰈀",
        "format-linked": "󰈀",
        "format-disconnected": "󰖪",
        "tooltip-format-wifi": "{essid}\nSignal: {signalStrength}%",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Network disconnected"
    },

    "custom/notification": {
        "format": "{icon}",
        "return-type": "json",
        "exec-if": "command -v swaync-client",
        "exec": "swaync-client -swb",
        "escape": true,
        "format-icons": {
            "notification": "󱅫",
            "none": "󰂚",
            "dnd-notification": "󰂛",
            "dnd-none": "󰂛",
            "inhibited-notification": "󰂛",
            "inhibited-none": "󰂚",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰂛"
        },
        "tooltip": false,
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw"
    },

    "clock": {
        "format": "  {:%A  %H:%M}",
        "format-alt": "  {:%a, %d %b}",
        "tooltip-format": "<big>{:%A, %d %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "group/group_power": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "children-class": "power-action",
            "transition-left-to-right": false
        },
        "modules": ["custom/power", "custom/quit", "custom/lock", "custom/reboot"]
    },

    "custom/quit": {
        "format": "󰍃",
        "tooltip": true,
        "tooltip-format": "Log out",
        "on-click": "hyprctl dispatch exit"
    },

    "custom/lock": {
        "format": "󰌾",
        "tooltip": true,
        "tooltip-format": "Lock",
        "on-click": "hyprlock"
    },

    "custom/reboot": {
        "format": "󰜉",
        "tooltip": true,
        "tooltip-format": "Reboot",
        "on-click": "reboot"
    },

    "custom/power": {
        "format": "󰐥",
        "tooltip": true,
        "tooltip-format": "Shut down",
        "on-click": "shutdown now"
    }
}
