#!/usr/bin/env bash

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=_common.sh
source "$script_dir/_common.sh"

volume_percent() {
    if command -v wpctl >/dev/null 2>&1; then
        local output value
        output="$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null || true)"
        value="$(awk '{ print $2 }' <<<"$output")"
        if [[ "$value" =~ ^[0-9]+\.?[0-9]*$ ]]; then
            awk -v volume="$value" 'BEGIN { printf "%d", volume * 100 }'
            return
        fi
    elif command -v pactl >/dev/null 2>&1; then
        pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null \
            | awk 'match($0, /[0-9]+%/) { print substr($0, RSTART, RLENGTH - 1); exit }'
        return
    fi
    printf '?'
}

is_muted() {
    if command -v wpctl >/dev/null 2>&1; then
        wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | grep -q '\[MUTED\]'
    elif command -v pactl >/dev/null 2>&1; then
        pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | grep -q 'yes'
    else
        return 1
    fi
}

change_volume() {
    local direction="$1"
    if command -v wpctl >/dev/null 2>&1; then
        wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ "5%${direction}" >/dev/null 2>&1 || true
    elif command -v pactl >/dev/null 2>&1; then
        local current target
        current="$(volume_percent)"
        [[ "$current" =~ ^[0-9]+$ ]] || return
        if [[ "$direction" == "+" ]]; then
            target=$((current + 5))
            ((target > 100)) && target=100
        else
            target=$((current - 5))
            ((target < 0)) && target=0
        fi
        pactl set-sink-volume @DEFAULT_SINK@ "${target}%" >/dev/null 2>&1 || true
    fi
}

toggle_mute() {
    if command -v wpctl >/dev/null 2>&1; then
        wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle >/dev/null 2>&1 || true
    elif command -v pactl >/dev/null 2>&1; then
        pactl set-sink-mute @DEFAULT_SINK@ toggle >/dev/null 2>&1 || true
    fi
}

toggle_microphone() {
    if command -v wpctl >/dev/null 2>&1; then
        wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle >/dev/null 2>&1 || true
    elif command -v pactl >/dev/null 2>&1; then
        pactl set-source-mute @DEFAULT_SOURCE@ toggle >/dev/null 2>&1 || true
    fi
}

render() {
    local volume status summary mute_state="normal"
    volume="$(volume_percent)"
    status="${volume}%"
    if is_muted; then
        status="$status · muted"
        mute_state="active"
    fi
    [[ "$volume" != "?" ]] || status="Volume backend unavailable"
    summary="  $status"

    mode_header "Sound" "$status"
    mode_option "theme" "textbox-volume { content: \"$(rasi_escape "$summary")\"; }"

    if [[ "$volume" == "?" ]]; then
        mode_row "Volume controls unavailable" "Install wireplumber or pulseaudio-utils" "dialog-warning-symbolic" "missing" "disabled"
        return
    fi

    mode_row "Volume down" "Lower output by 5%" "audio-volume-low-symbolic" "down"
    mode_row "Mute output" "Toggle speaker mute · currently $status" "audio-volume-muted-symbolic" "mute" "$mute_state"
    mode_row "Volume up" "Raise output by 5% · capped at 100%" "audio-volume-high-symbolic" "up"
    mode_row "Mute microphone" "Toggle the default input" "microphone-sensitivity-muted-symbolic" "microphone"
    if command -v pavucontrol >/dev/null 2>&1; then
        mode_row "Audio settings" "Open pavucontrol" "multimedia-volume-control-symbolic" "settings"
    fi
}

if [[ "${ROFI_RETV:-0}" == "1" ]]; then
    case "${ROFI_INFO:-}" in
        down) change_volume "-" ;;
        mute) toggle_mute ;;
        up) change_volume "+" ;;
        microphone) toggle_microphone ;;
        settings)
            launch_background pavucontrol
            exit 0
            ;;
    esac
    mode_option "keep-selection" "true"
fi

render
