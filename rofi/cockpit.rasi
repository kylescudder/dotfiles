* {
    background: #11111bf5;
    surface: #181825;
    selection: #313244d9;
    border: #45475a;
    text: #cdd6f4;
    muted: #7f849c;
    accent: #cba6f7;

    background-color: transparent;
    text-color: @text;
    font: "FiraCode Nerd Font 12";
}

window {
    width: 520px;
    location: center;
    anchor: center;
    border: 2px;
    border-color: @accent;
    border-radius: 12px;
    background-color: @background;
    padding: 12px;
}

mainbox {
    orientation: vertical;
    spacing: 10px;
    background-color: transparent;
    children: [ inputbar, listview ];
}

inputbar {
    orientation: horizontal;
    children: [ prompt, entry ];
    spacing: 10px;
    padding: 11px 14px;
    border: 1px;
    border-color: @border;
    border-radius: 9px;
    background-color: @surface;
}

prompt {
    text-color: @accent;
    font: "FiraCode Nerd Font SemiBold 11";
}

entry {
    expand: true;
    placeholder: "Search applications…";
    placeholder-color: @muted;
    text-color: @text;
}

listview {
    columns: 1;
    lines: 7;
    spacing: 4px;
    fixed-height: false;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    background-color: transparent;
}

element {
    orientation: horizontal;
    children: [ element-icon, element-text ];
    spacing: 13px;
    padding: 10px 12px;
    border: 1px;
    border-color: transparent;
    border-radius: 8px;
    background-color: transparent;
    text-color: @text;
    cursor: pointer;
}

element selected normal,
element selected active,
element selected urgent {
    border-color: @accent;
    background-color: @selection;
    text-color: @text;
}

element-icon {
    size: 30px;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}

scrollbar {
    width: 2px;
    background-color: @surface;
    handle-color: @accent;
}
