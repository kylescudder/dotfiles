/* Bento — playful utility tiles, roomy two-column scanning. */
* {
    cream:      #f8f3e8fa;
    card:       #fffdf7;
    ink:        #202225;
    muted:      #73706a;
    line:       #d9d1c3;
    coral:      #ee6a5b;
    butter:     #f2c94c;
    mint:       #9ed8bc;
    sky:        #8fc9ed;
    navy:       #24344d;
    danger:     #c73f49;

    background-color: transparent;
    text-color: @ink;
    border-color: @line;
    font: "FiraCode Nerd Font 11";
}

window {
    width: 1060px;
    height: 610px;
    location: center;
    anchor: center;
    border: 0px;
    border-radius: 26px;
    background-color: @cream;
    children: [ cockpit ];
}

cockpit {
    orientation: horizontal;
    padding: 16px;
    spacing: 14px;
    background-color: transparent;
    children: [ launcher-pane, control-rail ];
}

launcher-pane {
    orientation: vertical;
    expand: true;
    padding: 18px;
    spacing: 13px;
    border: 1px;
    border-color: @line;
    border-radius: 18px;
    background-color: @card;
    children: [ inputbar, message, listview, textbox-shortcuts ];
}

inputbar {
    orientation: horizontal;
    children: [ prompt, entry, case-indicator ];
    spacing: 12px;
    padding: 0px 15px;
    border: 2px;
    border-color: @navy;
    border-radius: 13px;
    background-color: @card;
}

prompt { padding: 14px 0px; text-color: @coral; font: "FiraCode Nerd Font SemiBold 11"; }
entry {
    expand: true;
    padding: 14px 0px;
    placeholder: "What do you need?";
    placeholder-color: @muted;
    text-color: @ink;
}
case-indicator { padding: 14px 0px; text-color: @navy; }
message { padding: 0px; background-color: transparent; }
textbox {
    padding: 7px 10px;
    border-radius: 8px;
    background-color: @cream;
    text-color: @muted;
    font: "FiraCode Nerd Font 8";
}

listview {
    expand: true;
    columns: 2;
    lines: 4;
    spacing: 9px;
    fixed-height: true;
    cycle: true;
    scrollbar: false;
    background-color: transparent;
}

element {
    orientation: horizontal;
    children: [ element-icon, element-text ];
    spacing: 11px;
    padding: 13px 12px;
    border: 1px;
    border-color: @line;
    border-radius: 12px;
    background-color: @cream;
    text-color: @muted;
    cursor: pointer;
}

element normal active,
element alternate active { border-color: @mint; background-color: @mint; text-color: @navy; }

element selected normal,
element selected active,
element selected urgent {
    border-color: @navy;
    background-color: @butter;
    text-color: @ink;
}

element selected urgent { border-color: @danger; background-color: @coral; }
element-icon { size: 34px; background-color: transparent; }
element-text { vertical-align: 0.5; background-color: transparent; text-color: inherit; }

textbox-shortcuts {
    content: "↑ ↓ move    ↵ open    ctrl+tab switch shelf    esc close";
    padding: 3px 2px 0px;
    text-color: @muted;
    font: "FiraCode Nerd Font 8";
}

control-rail {
    orientation: vertical;
    width: 270px;
    padding: 15px;
    spacing: 10px;
    border-radius: 18px;
    background-color: @navy;
    children: [ textbox-player-kicker, textbox-player-track, textbox-volume, mode-switcher, textbox-rail-hint ];
}

textbox-player-kicker {
    content: "YOUR DESK";
    padding: 6px 4px 0px;
    text-color: @butter;
    font: "FiraCode Nerd Font SemiBold 9";
}

textbox-player-track {
    content: "No active player";
    padding: 14px;
    border-radius: 12px;
    background-color: @mint;
    text-color: @navy;
    font: "FiraCode Nerd Font SemiBold 10";
}

textbox-volume {
    content: "  Volume unavailable";
    padding: 14px;
    border-radius: 12px;
    background-color: @sky;
    text-color: @navy;
    font: "FiraCode Nerd Font 9";
}

mode-switcher {
    orientation: vertical;
    expand: true;
    spacing: 5px;
    background-color: transparent;
}

button {
    padding: 10px 12px;
    border: 1px;
    border-color: #ffffff22;
    border-radius: 9px;
    background-color: transparent;
    text-color: #dbe5f2;
    horizontal-align: 0.0;
    cursor: pointer;
}

button selected { border-color: @butter; background-color: @coral; text-color: @card; }

textbox-rail-hint {
    content: "Pick a shelf, then choose a tile.";
    padding: 5px 3px;
    text-color: #a9b8ca;
    font: "FiraCode Nerd Font 8";
}

scrollbar { width: 3px; border-radius: 3px; background-color: @line; handle-color: @coral; }
