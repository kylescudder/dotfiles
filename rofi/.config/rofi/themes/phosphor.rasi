/* Phosphor — stripped-back CRT terminal with electric status states. */
* {
    black:      #020704f8;
    screen:     #07110b;
    cell:       #0b1c10;
    grid:       #174224;
    green:      #7dff9b;
    green-dim:  #4e9860;
    cyan:       #66f7d3;
    amber:      #ffc857;
    red:        #ff5864;

    background-color: transparent;
    text-color: @green;
    border-color: @grid;
    font: "FiraCode Nerd Font 12";
}

window {
    width: 1240px;
    height: 540px;
    location: center;
    anchor: center;
    border: 3px;
    border-color: @green-dim;
    border-radius: 0px;
    background-color: @black;
    children: [ cockpit ];
}

cockpit {
    orientation: vertical;
    padding: 7px;
    spacing: 7px;
    background-color: @black;
    children: [ control-rail, launcher-pane ];
}

control-rail {
    orientation: horizontal;
    height: 76px;
    spacing: 0px;
    border: 1px;
    border-color: @grid;
    background-color: @screen;
    children: [ textbox-player-kicker, mode-switcher, textbox-player-track, textbox-volume, textbox-rail-hint ];
}

textbox-player-kicker {
    content: "ROFI::TTY_07";
    width: 90px;
    padding: 12px 10px;
    border: 0px 1px 0px 0px;
    border-color: @grid;
    text-color: @cyan;
    font: "FiraCode Nerd Font SemiBold 8";
}

mode-switcher {
    orientation: horizontal;
    expand: true;
    background-color: transparent;
}

button {
    padding: 12px 7px;
    border: 0px 1px 0px 0px;
    border-color: @grid;
    background-color: transparent;
    text-color: @green-dim;
    cursor: pointer;
}

button selected { background-color: @green; text-color: @black; }

textbox-player-track {
    content: "No active player";
    width: 118px;
    padding: 12px 9px;
    border: 0px 1px 0px 0px;
    border-color: @grid;
    text-color: @green;
    font: "FiraCode Nerd Font 8";
}

textbox-volume {
    content: "  Volume unavailable";
    width: 106px;
    padding: 12px 9px;
    border: 0px 1px 0px 0px;
    border-color: @grid;
    text-color: @amber;
    font: "FiraCode Nerd Font 8";
}

textbox-rail-hint {
    content: "FIND\nEXEC";
    width: 34px;
    padding: 9px 6px;
    text-color: @green-dim;
    font: "FiraCode Nerd Font 7";
}

launcher-pane {
    orientation: vertical;
    expand: true;
    padding: 12px;
    spacing: 8px;
    border: 1px;
    border-color: @grid;
    background-color: @screen;
    children: [ inputbar, message, listview, textbox-shortcuts ];
}

inputbar {
    orientation: horizontal;
    children: [ prompt, entry, case-indicator ];
    spacing: 9px;
    padding: 0px 10px;
    border: 1px;
    border-color: @green-dim;
    background-color: @black;
}

prompt { padding: 12px 0px; text-color: @cyan; font: "FiraCode Nerd Font SemiBold 10"; }
entry {
    expand: true;
    padding: 12px 0px;
    placeholder: "grep applications_";
    placeholder-color: @green-dim;
    text-color: @green;
}
case-indicator { padding: 12px 0px; text-color: @amber; }
message { padding: 0px; background-color: transparent; }
textbox {
    padding: 6px 9px;
    border: 1px;
    border-color: @grid;
    background-color: @black;
    text-color: @green-dim;
    font: "FiraCode Nerd Font 8";
}

listview {
    expand: true;
    columns: 1;
    lines: 7;
    spacing: 2px;
    fixed-height: true;
    cycle: true;
    scrollbar: false;
    background-color: transparent;
}

element {
    orientation: horizontal;
    children: [ element-icon, element-text ];
    spacing: 11px;
    padding: 8px 10px;
    border: 1px;
    border-color: transparent;
    background-color: transparent;
    text-color: @green-dim;
    cursor: pointer;
}

element normal active,
element alternate active { background-color: @cell; text-color: @cyan; }

element selected normal,
element selected active,
element selected urgent {
    border-color: @green;
    background-color: @cell;
    text-color: @green;
}

element selected urgent { border-color: @red; text-color: @red; }
element-icon { size: 25px; background-color: transparent; }
element-text { vertical-align: 0.5; background-color: transparent; text-color: inherit; }

textbox-shortcuts {
    content: "[↑/↓] SELECT    [RETURN] SPAWN    [CTRL+TAB] MODE    [ESC] EXIT";
    padding: 5px 0px 0px;
    text-color: @green-dim;
    font: "FiraCode Nerd Font 8";
}

scrollbar { width: 2px; background-color: @grid; handle-color: @green; }
