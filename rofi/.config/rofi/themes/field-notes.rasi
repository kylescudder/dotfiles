/* Field Notes — warm paper, editorial rules, index-card calm. */
* {
    paper:      #f2eadbfa;
    sheet:      #fffaf0;
    ink:        #25231f;
    graphite:   #716b61;
    rule:       #c8bca8;
    rust:       #b84b32;
    moss:       #58705b;
    ochre:      #d6a53a;
    danger:     #a22f2f;

    background-color: transparent;
    text-color: @ink;
    border-color: @rule;
    font: "FiraCode Nerd Font 12";
}

window {
    width: 1180px;
    height: 620px;
    location: center;
    anchor: center;
    border: 1px;
    border-color: @ink;
    border-radius: 1px;
    background-color: @paper;
    children: [ cockpit ];
}

cockpit {
    orientation: vertical;
    padding: 22px;
    spacing: 14px;
    background-color: @paper;
    children: [ launcher-pane, control-rail ];
}

launcher-pane {
    orientation: vertical;
    expand: true;
    spacing: 13px;
    background-color: transparent;
    children: [ inputbar, message, listview, textbox-shortcuts ];
}

inputbar {
    orientation: horizontal;
    children: [ prompt, entry, case-indicator ];
    spacing: 10px;
    padding: 0px 2px;
    border: 0px 0px 2px;
    border-color: @ink;
    background-color: transparent;
}

prompt {
    padding: 14px 0px 11px;
    text-color: @rust;
    font: "FiraCode Nerd Font SemiBold 12";
}

entry {
    expand: true;
    padding: 14px 0px 11px;
    placeholder: "Search the index…";
    placeholder-color: @graphite;
    text-color: @ink;
}

case-indicator { padding: 14px 0px 11px; text-color: @moss; }
message { padding: 0px; background-color: transparent; }
textbox {
    padding: 7px 10px;
    border: 1px;
    border-color: @rule;
    background-color: @sheet;
    text-color: @graphite;
    font: "FiraCode Nerd Font 9";
}

listview {
    expand: true;
    columns: 1;
    lines: 7;
    spacing: 5px;
    fixed-height: true;
    cycle: true;
    scrollbar: true;
    background-color: transparent;
}

element {
    orientation: horizontal;
    children: [ element-icon, element-text ];
    spacing: 14px;
    padding: 9px 12px;
    border: 1px;
    border-color: @rule;
    background-color: @sheet;
    text-color: @graphite;
    cursor: pointer;
}

element normal active,
element alternate active {
    border-color: @moss;
    text-color: @moss;
}

element selected normal,
element selected active,
element selected urgent {
    border: 1px 1px 1px 5px;
    border-color: @rust;
    background-color: @sheet;
    text-color: @ink;
}

element selected urgent { border-color: @danger; }
element-icon { size: 30px; background-color: transparent; }
element-text { vertical-align: 0.5; background-color: transparent; text-color: inherit; }

textbox-shortcuts {
    content: "ARROWS to browse   ·   ENTER to open   ·   ESC to close";
    padding: 3px 2px 0px;
    text-color: @graphite;
    font: "FiraCode Nerd Font 8";
}

control-rail {
    orientation: horizontal;
    height: 104px;
    padding: 12px;
    spacing: 10px;
    border: 1px;
    border-color: @rule;
    background-color: @sheet;
    children: [ textbox-player-kicker, textbox-player-track, mode-switcher, textbox-volume, textbox-rail-hint ];
}

textbox-player-kicker {
    content: "FIELD / 01";
    width: 72px;
    padding: 8px;
    background-color: @ochre;
    text-color: @ink;
    font: "FiraCode Nerd Font SemiBold 8";
}

textbox-player-track {
    content: "No active player";
    width: 145px;
    padding: 8px;
    border: 0px 1px 0px 0px;
    border-color: @rule;
    text-color: @moss;
    font: "FiraCode Nerd Font SemiBold 9";
}

mode-switcher {
    orientation: horizontal;
    expand: true;
    spacing: 2px;
    background-color: transparent;
}

button {
    padding: 8px 6px;
    border: 0px 0px 2px;
    border-color: transparent;
    background-color: transparent;
    text-color: @graphite;
    cursor: pointer;
}

button selected { border-color: @rust; text-color: @rust; }

textbox-volume {
    content: "  Volume unavailable";
    width: 122px;
    padding: 8px;
    border: 0px 0px 0px 1px;
    border-color: @rule;
    text-color: @ink;
    font: "FiraCode Nerd Font 8";
}

textbox-rail-hint {
    content: "CTRL+TAB";
    width: 54px;
    padding: 8px 2px;
    text-color: @rust;
    font: "FiraCode Nerd Font SemiBold 7";
}

scrollbar { width: 2px; background-color: @rule; handle-color: @rust; }
