/* A narrow, hard-edged launcher shaped to match this Catppuccin desktop. */
* {
    background: #11111bf5;
    search:     #181825;
    selection:  #313244b8;
    line:       #45475a;
    text:       #cdd6f4;
    muted:      #7f849c;
    accent:     #cba6f7;
    active:     #94e2d5;
    urgent:     #f38ba8;

    background-color: transparent;
    text-color: @text;
    border-color: @line;
    font: "FiraCode Nerd Font 12";
}

window {
    width: 560px;
    height: 620px;
    location: center;
    anchor: center;
    border: 2px;
    border-color: @accent;
    border-radius: 0px;
    background-color: @background;
    children: [ cockpit ];
}

cockpit {
    orientation: vertical;
    padding: 14px;
    background-color: transparent;
    children: [ launcher-pane ];
}

launcher-pane {
    orientation: vertical;
    expand: true;
    spacing: 9px;
    background-color: transparent;
    children: [ inputbar, message, listview, textbox-shortcuts ];
}

inputbar {
    orientation: horizontal;
    children: [ prompt, entry, case-indicator ];
    spacing: 11px;
    padding: 0px 14px;
    border: 1px;
    border-color: @line;
    border-radius: 0px;
    background-color: @search;
}

prompt {
    padding: 15px 0px;
    text-color: @accent;
    font: "FiraCode Nerd Font SemiBold 11";
}

entry {
    expand: true;
    padding: 15px 0px;
    placeholder: "Search apps, windows, commands, and actions…";
    placeholder-color: @muted;
    text-color: @text;
}

case-indicator {
    padding: 15px 0px;
    text-color: @muted;
    font: "FiraCode Nerd Font 9";
}

message {
    padding: 0px;
    border: 0px;
    background-color: transparent;
}

textbox {
    padding: 8px 12px;
    border: 1px;
    border-color: @line;
    border-radius: 0px;
    background-color: @search;
    text-color: @muted;
    font: "FiraCode Nerd Font 9";
}

listview {
    expand: true;
    columns: 1;
    lines: 8;
    spacing: 2px;
    fixed-height: true;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    background-color: transparent;
}

element {
    orientation: horizontal;
    children: [ element-icon, element-text ];
    spacing: 14px;
    padding: 12px 14px;
    border: 1px;
    border-color: transparent;
    border-radius: 0px;
    background-color: transparent;
    text-color: @text;
    cursor: pointer;
}

element normal active,
element alternate active {
    text-color: @active;
}

element selected normal,
element selected active,
element selected urgent {
    border-color: @accent;
    background-color: @selection;
    text-color: @accent;
}

element selected urgent {
    border-color: @urgent;
    text-color: @urgent;
}

element-icon {
    size: 28px;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}

textbox-shortcuts {
    content: "↑↓ select     ↵ open     esc close";
    padding: 7px 4px 2px;
    border: 1px 0px 0px 0px;
    border-color: @line;
    background-color: transparent;
    text-color: @muted;
    font: "FiraCode Nerd Font 8";
}

scrollbar {
    width: 2px;
    background-color: @search;
    handle-color: @accent;
}
