{
  config,
  inputs,
  lib,
  pkgs,
  ...
}:
let
  clipboard = lib.getExe config.programs.nix-clipboard-history.package;
  startCapture = pkgs.writeShellScript "start-clipboard-history" ''
    set -eu
    ${pkgs.dbus}/bin/dbus-update-activation-environment --systemd \
      WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE XDG_CURRENT_DESKTOP
    ${pkgs.systemd}/bin/systemctl --user restart nix-clipboard-history.service
  '';
in
{
  imports = [ inputs.nix-clipboard-history.homeManagerModules.default ];

  programs.nix-clipboard-history = {
    enable = true;
    settings.auto_paste = true;
    # Hyprland's Lua configuration is live-linked by dotfiles.nix.
    hyprland.enable = false;
  };

  # Skip capture in GNOME and before Hyprland has supplied its session environment.
  systemd.user.services.nix-clipboard-history.Unit.ConditionEnvironment = [
    "WAYLAND_DISPLAY"
    "HYPRLAND_INSTANCE_SIGNATURE"
    "XDG_CURRENT_DESKTOP=Hyprland"
  ];

  # Keep store paths generated by Nix out of the editable Hyprland configuration.
  xdg.configFile."hypr/nix-clipboard-history.lua".text = ''
    hl.bind('SUPER + SHIFT + V', hl.dsp.exec_cmd('${clipboard} show'))

    hl.on('hyprland.start', function()
        hl.exec_cmd('${startCapture}')
    end)
  '';
}
